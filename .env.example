# ==============================================================================
# TaskMaster API - Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

ENVIRONMENT=development
PORT=8080

# Database Configuration (Defaults to embedded H2 for zero-config CommandBox startup)
DB_TYPE=h2
DB_NAME=taskmaster_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=

# Security & Authentication
# IMPORTANT: Generate a cryptographically secure 256-bit string in production!
JWT_SECRET=super_secret_signing_key_cfml_showcase_change_me_in_production_32chars!
TOKEN_EXPIRATION_MINUTES=120
